# Local development only. Never use these credentials in production.
POSTGRES_PASSWORD=tutorbot-local-db
LITELLM_MASTER_KEY=sk-tutorbot-local-proxy
LITELLM_BASE_URL=http://litellm:4000/v1
# Fixed aliases: tutor-reasoning, document-vision, assessment-analysis,
# context-classification, teaching-distillation, embeddings.
# Model IDs must be in app/model_gateway/registry.json. Unknown IDs fail closed.
# Change only TUTOR_MODEL to deepseek/deepseek-v4-pro for text tutoring.
TUTOR_MODEL=openai/gpt-4o-mini-2024-07-18
ASSESSMENT_MODEL=openai/gpt-4o-mini-2024-07-18
CONTEXT_MODEL=openai/gpt-4o-mini-2024-07-18
DISTILLATION_MODEL=openai/gpt-4o-mini-2024-07-18
VISION_MODEL=openai/gpt-4o-2024-08-06
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=not-configured
DEEPSEEK_API_KEY=not-configured
GEMINI_API_KEY=not-configured

# Distinct local service credentials. Never pass privileged values to API services.
MIGRATOR_DB_PASSWORD=tutorbot-local-migrator
RUNTIME_DB_PASSWORD=tutorbot-local-runtime
ADMIN_DB_PASSWORD=tutorbot-local-admin
